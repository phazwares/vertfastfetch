#!/bin/bash
# GUI_SCRIPT
# ~/.config/hypr/scripts/fastfetch-vertical
#
# Experimental: renders every module's value as its own vertical
# (one-character-per-line) column, side by side, with the logo above,
# both centered against the same terminal width.
#
# Opens in its own dedicated, floating kitty window sized to the
# logo's own width (40 cells) -- marked GUI_SCRIPT so scripts-menu
# doesn't also wrap it in its own kitty --hold window, which would
# otherwise leave two separate kitty windows open (the wrapper, plus
# this script's own dedicated one). FASTFETCH_VERTICAL_FLOATING is
# used as a marker to detect whether this invocation is already
# running inside that dedicated window (proceed normally) or is the
# original scripts-menu invocation (relaunch into the dedicated
# window, then exit). A matching windowrules.lua rule floats any
# window with the fastfetch-vertical class.
#
# Window height is calculated dynamically rather than a fixed guess,
# so the window ends exactly where the content does ("wraps to the
# last letter") instead of leaving excess blank space or cutting
# content off. This requires a real pre-launch calculation: the
# window's size has to be set before kitty even starts, but the
# actual content height is only known after fastfetch runs -- which
# normally happens INSIDE the already-launched window. The snippet
# below runs that same fastfetch call and the identical filtering
# logic used in the main render further down (same <=6-character key
# filter, same module list) purely to compute a height, before kitty
# ever launches. Keep both in sync if the module list changes --
# genuine duplication, accepted since fastfetch itself is fast enough
# that calling it twice is not a real cost.
# ---- Tuning: gap between the logo and the text ----
# How many rows to pull the text up after the logo is drawn. Raise it
# for a tighter gap; lower it if the top of the text starts overlapping
# the logo art (0 = fastfetch's own spacing, the original look). Both
# the render and the window-height calculation read this, so the
# window shrinks by the same amount instead of leaving blank rows at
# the bottom. If your logo.png has empty space along its bottom edge,
# that space counts as gap too -- cropping the image in Inkscape
# (Edit > Resize Page to Selection, Shift+Ctrl+R) removes it at the source.
export FASTFETCH_VERTICAL_GAP_TRIM="${FASTFETCH_VERTICAL_GAP_TRIM:-1}"

if [[ -z "$FASTFETCH_VERTICAL_FLOATING" ]]; then
	CALCULATED_HEIGHT=$(python3 << 'HEIGHTEOF'
import subprocess, json, tempfile, os

text_modules_config = {
	"logo": {"type": "none"},
	"modules": [
		"title", "os", "kernel", "wm", "host", "cpu", "gpu",
		"memory", "swap", "disk", "display",
		"icons", "font", "terminal", "shell", "packages"
	]
}
with tempfile.NamedTemporaryFile(mode='w', suffix='.jsonc', delete=False) as f:
	json.dump(text_modules_config, f)
	config_path = f.name

result = subprocess.run(
	["fastfetch", "--config", config_path, "--pipe"],
	capture_output=True, text=True
)
os.unlink(config_path)

column_heights = []
for line in result.stdout.splitlines():
	if ": " not in line:
		continue
	key, _, value = line.partition(": ")
	if len(key) > 6:
		continue
	column_heights.append(len(key) + 1 + len(value))

# Colors column: 6 title chars + 1 blank separator + 16 color blocks
column_heights.append(6 + 1 + 16)

LOGO_HEIGHT = 20
GAP_TRIM = max(0, int(os.environ.get("FASTFETCH_VERTICAL_GAP_TRIM", "0")))
print(LOGO_HEIGHT - GAP_TRIM + max(column_heights))
HEIGHTEOF
	)

	# Safety net: if the calculation above failed (a Python error, or
	# fastfetch output it didn't expect), use a reasonable default
	# instead of handing kitty an empty height, which makes it refuse
	# to open. Run this script from a terminal to see the actual error.
	if ! [[ "$CALCULATED_HEIGHT" =~ ^[0-9]+$ ]]; then
		notify-send "fastfetch-vertical" "Height calculation failed; using a default size. Run it from a terminal to see why." 2>/dev/null
		CALCULATED_HEIGHT=45
	fi

	exec kitty --class=fastfetch-vertical \
		-o initial_window_width=40c \
		-o initial_window_height=${CALCULATED_HEIGHT}c \
		-o remember_window_size=no \
		-o font_size=8.0 \
		env FASTFETCH_VERTICAL_FLOATING=1 "$0"
fi
#
# Confirmed no prior art exists for this in fastfetch/neofetch
# specifically (checked via web search) -- the underlying technique
# (splitting text into one-char-per-line) is a real, standard shell
# trick, just not previously applied here. Genuinely experimental.
#
# Architecture, and why it's built this way:
# - fastfetch itself cannot render vertical text natively (confirmed --
#   its format strings do simple {placeholder} substitution on
#   detected values, with no per-character line-splitting capability
#   at all). This script handles that externally instead.
# - --pipe strips all ANSI colors, which is needed to get clean,
#   parseable "Key: Value" text for every module -- but that would
#   also strip the ACTUAL colors from the "colors" module, defeating
#   its purpose. So colors are generated directly here instead (see
#   below) rather than parsed from fastfetch's own colors module output.
# - The logo is left as fastfetch's own normal kitty-direct rendering
#   (a real image, not text), printed before the text columns, both
#   centered against the same shared terminal width.
#
# Title color is the theme's accent, read live from
# ~/.config/theme/state.toml on every render -- so it always matches
# the current theme with nothing to sync.
#
# Re-centering on live resize: the render logic below is wrapped in a
# function and re-run on every SIGWINCH (the signal the terminal sends
# on a resize), rather than rendering once and leaving static output
# on screen. Both the logo's and the text block's centering are
# recalculated from the terminal's current width EVERY time this
# function runs -- since both always share that same, freshly
# recalculated reference point, they stay aligned with each other on
# every resize, not just independently centered. The screen is
# cleared before each re-render so the previous, differently-centered
# output doesn't remain alongside the new one. Honest caveat: I
# couldn't directly verify a SIGWINCH trap firing correctly while a
# script is blocked in a wait loop in my own sandbox (a background
# process + signal test here didn't behave reliably) -- this uses the
# standard, well-documented bash pattern for it, but is worth testing
# directly once actually run.
render_fastfetch() {
	clear
	python3 << 'PYEOF'
import subprocess
import json
import tempfile
import os
import re
import shutil

def visible_len(s):
	"""Length excluding ANSI escape codes -- needed because colored
	text (the Colors column's blocks, and now the colored titles too)
	contains invisible escape sequences that Python's own string
	formatting would otherwise count as visible characters, badly
	misaligning columns against plain-text ones. Confirmed as a real
	bug via direct testing earlier: a color block's raw length (11
	chars) vs its actual visible width (2 chars) produced almost no
	padding at all."""
	return len(re.sub(r'\033\[[0-9;]*m', '', s))

def center_ansi_aware(s, width):
	vlen = visible_len(s)
	total_pad = max(0, width - vlen)
	left = total_pad // 2
	right = total_pad - left
	return (' ' * left) + s + (' ' * right)

# Title color -- the theme's accent, read from the theme script's
# state file. Falls back to a neutral blue if that can't be read.
try:
	import tomllib
	with open(os.path.expanduser("~/.config/theme/state.toml"), "rb") as _f:
		_acc = tomllib.load(_f)["colors"]["accent"].lstrip("#")
	_r, _g, _b = (int(_acc[i:i + 2], 16) for i in (0, 2, 4))
except Exception:
	_r, _g, _b = 110, 124, 199
TITLE_COLOR = f"\033[38;2;{_r};{_g};{_b}m"
RESET = "\033[0m"

def colored_title_chars(key):
	return [f"{TITLE_COLOR}{ch}{RESET}" for ch in key]

# Recalculated on every call (including every resize), so the logo
# and text always center against the current, live terminal width --
# never a stale value from an earlier size.
TERM_WIDTH = shutil.get_terminal_size().columns
LOGO_WIDTH = 40
LOGO_HEIGHT = 20

# ---- Logo: fastfetch's own normal rendering, shown first, centered ----
logo_left_pad = max(0, (TERM_WIDTH - LOGO_WIDTH) // 2)
logo_config = {
	"logo": {
		"type": "kitty-direct",
		"source": os.path.expanduser("~/.backgrounds/current/logo/logo.png"),
		"width": LOGO_WIDTH,
		"height": LOGO_HEIGHT,
		"padding": {"left": logo_left_pad}
	},
	"modules": []
}
with tempfile.NamedTemporaryFile(mode='w', suffix='.jsonc', delete=False) as f:
	json.dump(logo_config, f)
	logo_config_path = f.name

subprocess.run(["fastfetch", "--config", logo_config_path])
os.unlink(logo_config_path)

# Pull the text up into the space fastfetch leaves below the image
# (see FASTFETCH_VERTICAL_GAP_TRIM at the top of the script). "ESC[nA"
# moves the cursor up n rows; the text rows printed next land there.
# The image itself isn't erased by text printed over its rows, and any
# transparent part of it lets that text show through.
GAP_TRIM = max(0, int(os.environ.get("FASTFETCH_VERTICAL_GAP_TRIM", "0")))
if GAP_TRIM:
	print(f"\033[{GAP_TRIM}A", end="", flush=True)

# ---- Text modules: one fastfetch call, --pipe for clean parsing ----
text_modules_config = {
	"logo": {"type": "none"},
	"modules": [
		"title", "os", "kernel", "wm", "host", "cpu", "gpu",
		"memory", "swap", "disk", "display",
		"icons", "font", "terminal", "shell", "packages"
	]
}
with tempfile.NamedTemporaryFile(mode='w', suffix='.jsonc', delete=False) as f:
	json.dump(text_modules_config, f)
	text_config_path = f.name

result = subprocess.run(
	["fastfetch", "--config", text_config_path, "--pipe"],
	capture_output=True, text=True
)
os.unlink(text_config_path)

columns = {}
column_order = []
for line in result.stdout.splitlines():
	if ": " not in line:
		continue
	key, _, value = line.partition(": ")
	# Only keep modules whose label itself is 6 characters or less --
	# checked against the actual parsed key, not a hardcoded module
	# list, so this naturally excludes dynamically-named ones too
	# (e.g. "Disk (/run/media/phoojee/ART_DRIVE)"), not just the
	# fixed-length ones like "Terminal"/"Packages"/"Display".
	if len(key) > 6:
		continue
	# Title's own characters stacked above the value's, with one
	# blank row as a separator -- keeps the whole column consistently
	# vertical instead of mixing a horizontal header with vertical data.
	# Title characters are colored; value characters are left plain.
	columns[key] = colored_title_chars(key) + [""] + list(value)
	column_order.append(key)

# ---- Colors: generated directly, not parsed from fastfetch's own
# colors module -- see header comment for why. "Colors" is 6
# characters, kept under the same length filter as everything else.
# Its own title is now colored too, matching every other column. ----
COLOR_CODES = list(range(40, 48)) + list(range(100, 108))
columns["Colors"] = colored_title_chars("Colors") + [""] + [f"\033[{c}m  \033[0m" for c in COLOR_CODES]
column_order.append("Colors")

# ---- Transpose all columns side by side, minimal spacing ----
max_height = max(len(v) for v in columns.values())
col_width = 1  # smallest reasonable width -- just the character
# itself, no internal padding. Columns joined by a single space
# for the tightest layout that still keeps adjacent columns visually
# distinguishable.

rows = []
for row in range(max_height):
	cells = []
	for name in column_order:
		col = columns[name]
		cells.append(col[row] if row < len(col) else " ")
	rows.append(" ".join(center_ansi_aware(c, col_width) for c in cells))

# Center the whole text block within the same terminal width used for
# the logo above, so both share one reference point -- recalculated
# fresh on every call, so they stay in line with each other on resize,
# not just independently centered.
block_width = max(visible_len(r) for r in rows)
left_pad = max(0, (TERM_WIDTH - block_width) // 2)

for r in rows:
	print((" " * left_pad) + r)
PYEOF
}

render_fastfetch

# Re-render on every terminal resize (SIGWINCH), so the logo and text
# both re-center against the new width instead of leaving the
# original, now-stale centering on screen.
trap render_fastfetch WINCH

# Blocks here indefinitely (rather than using kitty's own --hold,
# which re-invokes a real shell once the command finishes -- that
# shell's own prompt was the "terminal prompt at the bottom" this was
# meant to remove). Since this script itself never exits, kitty never
# reaches the point of falling back to a shell at all -- only the
# fastfetch output above stays visible. Close the window normally
# (e.g. its close button, or a window-manager close keybind) when done.
# A repeating short sleep is used instead of one long `sleep infinity`
# so the WINCH trap has a genuine chance to interrupt and fire between
# iterations, rather than relying on a single long-lived sleep call to
# reliably resume after being interrupted.
while true; do
	sleep 1
done
